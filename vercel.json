{
  "rewrites": [
    { "source": "/admin", "destination": "/index.html" },
    { "source": "/admin/", "destination": "/index.html" },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "p" }],
      "destination": "/api/og"
    },
    {
      "source": "/",
      "has": [{ "type": "query", "key": "post" }],
      "destination": "/api/og"
    },
    { "source": "/post/:id", "destination": "/api/og?p=:id" },
    { "source": "/p/:id", "destination": "/api/og?p=:id" },
    { "source": "/extend", "destination": "/index.html" },
    { "source": "/extend/", "destination": "/index.html" },
    { "source": "/wall", "destination": "/index.html" },
    { "source": "/wall/", "destination": "/index.html" },
    { "source": "/goontok", "destination": "/index.html" },
    { "source": "/goontok/", "destination": "/index.html" },
    { "source": "/explore", "destination": "/index.html" },
    { "source": "/explore/", "destination": "/index.html" },
    { "source": "/spotlight", "destination": "/index.html" },
    { "source": "/spotlight/", "destination": "/index.html" },
    { "source": "/feed", "destination": "/index.html" },
    { "source": "/feed/", "destination": "/index.html" },
    { "source": "/videos", "destination": "/index.html" },
    { "source": "/videos/", "destination": "/index.html" },
    { "source": "/map", "destination": "/index.html" },
    { "source": "/map/", "destination": "/index.html" },
    { "source": "/coins", "destination": "/index.html" },
    { "source": "/coins/", "destination": "/index.html" },
    { "source": "/messages", "destination": "/index.html" },
    { "source": "/messages/", "destination": "/index.html" },
    { "source": "/profile", "destination": "/index.html" },
    { "source": "/profile/", "destination": "/index.html" },
    { "source": "/randomcam", "destination": "/index.html" },
    { "source": "/randomcam/", "destination": "/index.html" },
    { "source": "/roulette", "destination": "/index.html" },
    { "source": "/roulette/", "destination": "/index.html" },
    { "source": "/dice", "destination": "/index.html" },
    { "source": "/dice/", "destination": "/index.html" }
  ]
}
